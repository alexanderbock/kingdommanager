# Port and host the Node server listens on
PORT=3000
HOST=127.0.0.1

# Base path the app is served under. Must start and end with "/".
# Use "/kingdom/" when running behind the Apache sub-path from the README.
BASE_PATH=/

# SQLite database file location
DB_PATH=./data/kingdom.sqlite

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
