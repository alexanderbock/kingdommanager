{
  "name": "kingdom-manager",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @kingdom/shared && npm run build -w @kingdom/server && npm run build -w @kingdom/web",
    "typecheck": "npm run typecheck -w @kingdom/shared -w @kingdom/server -w @kingdom/web",
    "test": "npm run test -w @kingdom/server",
    "test:e2e": "npm run test:e2e -w @kingdom/web",
    "start": "node --env-file-if-exists=.env apps/server/dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.15.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
